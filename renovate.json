{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "enabledManagers": ["github-actions", "dockerfile"],
  "minimumReleaseAge": "14 days",
  "schedule": ["before 6am on monday"],
  "dependencyDashboard": true,
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["actions/*"],
      "pinDigests": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "commitMessageTopic": "GitHub Actions"
    },
    {
      "description": "Upgrade gh-aw with its compiler, generated workflows, and pinned delivery helper hashes together",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["github/gh-aw", "github/gh-aw/**"],
      "enabled": false
    },
    {
      "description": "Generated workflows are compiled from their Markdown sources with the pinned gh-aw toolchain",
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/pr-review.lock.yml",
        ".github/workflows/librarian.lock.yml",
        ".github/workflows/maintainer.lock.yml",
        ".github/workflows/dependency-maintenance.lock.yml"
      ],
      "enabled": false
    },
    {
      "description": "Coordinate the Claude action with its bundled CLI/SDK compatibility checks and pinned workflow test",
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/claude-review.yml"
      ],
      "matchPackageNames": [
        "anthropics/claude-code-action"
      ],
      "enabled": false
    },
    {
      "description": "Keep the maintenance Python runtime coordinated with .python-version",
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/maintainer-dependencies.yml"
      ],
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "container base images",
      "commitMessageTopic": "container base images"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["ghcr.io/immich-app/immich-server"],
      "enabled": false
    }
  ]
}
